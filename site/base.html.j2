<!DOCTYPE html>
<html lang="{{ i18n_page_locale | default('en') }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    {# Preview only: keep the site out of search results. Remove at GA. #}
    <meta name="robots" content="noindex, nofollow">
    <title>{% if page.title %}{{ page.title }} - {% endif %}{{ config.site_name }}</title>

    <!-- Pure CSS (https://pure-css.github.io/) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.0.0/build/pure-min.css" integrity="sha384-X38yfunGUhNzHpBaEBsWLO+A0HDYOQi8ufWDkZ0k9e0eXz/tH3II7uKZ9msv++Ls" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ 'css/theme.css' | url }}">

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha256-3edrmyuQ0w65f8gfBsqowzjJe2iM6n0nKciPUp8y+7E=" crossorigin="anonymous"></script>
    <script src="{{ 'js/theme.js' | url }}"></script>

    <!-- Carbon theme zones (white, g10, g90, g100) -->
    <link rel="stylesheet" href="https://1.www.s81c.com/common/carbon/web-components/tag/latest/themes.css" />

    <!-- The Carbon web-components/framework -->
    <script type="module" src="https://1.www.s81c.com/common/carbon/web-components/version/v2.15.0/ui-shell.min.js"></script>
    <script type="module" src="https://1.www.s81c.com/common/carbon/web-components/version/v2.15.0/accordion.min.js"></script>
    <script type="module" src="https://1.www.s81c.com/common/carbon/web-components/version/v2.15.0/breadcrumb.min.js"></script>
    <script type="module" src="https://1.www.s81c.com/common/carbon/web-components/version/v2.15.0/select.min.js"></script>
    <script type="module" src="https://1.www.s81c.com/common/carbon/web-components/version/v2.15.0/tabs.min.js"></script>
    <script type="module" src="https://1.www.s81c.com/common/carbon/web-components/version/v2.15.0/search.min.js"></script>

    <!-- HighlightJS code formatting support -->
    <link rel="stylesheet" id="hljs-light" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/github.min.css">
    <link rel="stylesheet" id="hljs-dark" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/github-dark.min.css" disabled>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/languages/yaml.min.js"></script>
    <script>hljs.highlightAll();</script>

    <!-- Required by MkDocs search -->
    <script>var base_url = {{ base_url | tojson }};</script>
    {#- Each language has its own search page (docs/search.md, docs/search.<lang>.md) -#}
    <script>var search_url = {{ ((base_url ~ '/' ~ (i18n_page_locale ~ '/' if i18n_page_locale and i18n_page_locale != (i18n_config.languages | selectattr('default') | map(attribute='locale') | first) else '') ~ 'search.html') if i18n_config else (base_url ~ '/search.html')) | tojson }};</script>

    <!-- User defined extras -->
    {% block extrahead %}
    {% endblock %}

    {% for path in config.extra_css %}
    <link href="{{ path | url }}" rel="stylesheet">
    {% endfor %}

    {% for script in config.extra_javascript %}
    {{ script | script_tag }}
    {% endfor %}
  </head>

  <body class="md-grid" data-theme-default="{{ config.theme.theme_default | default('g90') }}">
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="cds--skip-to-content" tabindex="0">Skip to main content</a>

    <!-- Header -->
    <cds-header aria-label="{{ config.site_name }}" class="md-header" role="banner">
      <cds-header-menu-button button-label-active="Close menu" button-label-inactive="Open menu"></cds-header-menu-button>
      <cds-header-name href="{{ base_url }}" prefix="{{ config.theme.prefix }}">{{ config.site_name }}</cds-header-name>

      {%- if config.theme.header_nav_items and config.theme.header_nav_items | length > 0 %}
      <cds-header-nav menu-bar-label="{{ config.theme.prefix }} {{ config.site_name }}">
        {%- for nav_item in config.theme.header_nav_items %}
          <cds-header-nav-item {{ 'is-active' if nav_item.active }} target="{{ nav_item.target }}" href="{{ nav_item.url }}">{{ nav_item.title }}</cds-header-nav-item>
        {%- endfor %}
      </cds-header-nav>
      {%- endif %}

      <div class="cds--header__global">
        {#- Language switcher: built from the mkdocs-static-i18n per-page alternates -#}
        {%- if page and page.file and page.file.alternates and i18n_config %}
        <nav class="language-switcher" aria-label="Language">
          {%- for lang in i18n_config.languages if lang.build and lang.locale in page.file.alternates %}
          <a href="{{ page.file.alternates[lang.locale].url | url }}" lang="{{ lang.locale }}" hreflang="{{ lang.locale }}"{% if lang.locale == i18n_page_locale %} aria-current="true"{% endif %}>{{ lang.name }}</a>
          {%- endfor %}
        </nav>
        {%- endif %}
        {%- include "theme-toggle.html.j2" %}
        {# Search removed - using navigation search instead #}
      </div>

      {% if page and page.edit_url %}
        <cds-header-nav>
          <cds-header-nav-item href="{{ page.edit_url }}">Edit on {{ config.repo_name }}</cds-header-nav-item>
        </cds-header-nav>
      {% endif %}
    </cds-header>

    <!-- Main container with three-column layout -->
    <div class="md-container" {% if page and page.meta and page.meta.widescreen %}data-widescreen="true"{% endif %}>
      <!-- Left sidebar - Navigation -->
      <aside class="md-sidebar md-sidebar--primary" data-md-component="sidebar" role="navigation" aria-label="Main Navigation">
        <div class="md-sidebar__scrollwrap">
          <div class="md-sidebar__inner">
            <cds-side-nav aria-label="Side navigation">
              <div class="nav-search-container">
                <input type="text" id="nav-search-input" class="nav-search-input" placeholder="Search" aria-label="Search navigation">
              </div>
              <cds-side-nav-items>
                {% for nav_item in nav %}
                  {% set nav_level = 1 %}
                  {% include "nav.html.j2" %}
                {% endfor %}
              </cds-side-nav-items>
            </cds-side-nav>
          </div>
        </div>
      </aside>
      <script>
      (function() {
          var input = document.getElementById('nav-search-input');
          if (!input) return;
          input.addEventListener('keydown', function(e) {
              if (e.key === 'Enter') {
                  var query = input.value.trim();
                  if (query) {
                      window.location.href = search_url + '?q=' + encodeURIComponent(query);
                  }
              }
          });
          input.addEventListener('input', function() {
              var query = input.value.toLowerCase().trim();
              var navItems = document.querySelectorAll('cds-side-nav-menu-item, cds-side-nav-menu');
              navItems.forEach(function(item) {
                  if (query === '' || item.textContent.toLowerCase().includes(query)) {
                      item.style.display = '';
                      if (query && item.tagName === 'CDS-SIDE-NAV-MENU-ITEM') {
                          var parent = item.closest('cds-side-nav-menu');
                          if (parent) parent.setAttribute('expanded', '');
                      }
                  } else {
                      item.style.display = 'none';
                  }
              });
          });
          document.querySelectorAll('cds-side-nav-menu-item').forEach(function(item) {
              item.addEventListener('click', function() {
                  var query = input.value.trim();
                  if (query) {
                      var href = item.getAttribute('href');
                      if (href && !href.includes('highlight=')) {
                          var sep = href.includes('?') ? '&' : '?';
                          item.setAttribute('href', href + sep + 'highlight=' + encodeURIComponent(query));
                      }
                  }
              });
          });
      })();
      </script>

      <!-- Main content area -->
      <main id="main-content" class="md-content" data-md-component="content" tabindex="-1">
        <article class="md-content__inner">
          <!-- Breadcrumbs -->
          <div class="md-breadcrumbs">
            {%- include "breadcrumbs.html.j2" %}
          </div>

          {#- Machine-translation notice (translated pages) and fallback notice (untranslated pages) -#}
          {%- set mt_notice = {
            'fr': {
              'translated': 'Cette page a été traduite automatiquement.',
              'english_link': 'Lire la version anglaise',
              'fallback': 'Cette page n’est pas encore traduite en français. La version anglaise s’affiche.'
            }
          } -%}
          {%- if i18n_page_locale and i18n_page_locale in mt_notice and page and page.file and page.file.alternates %}
          {%- set notice = mt_notice[i18n_page_locale] %}
          <div class="mt-notice" role="note" lang="{{ i18n_page_locale }}">
            {%- if i18n_file_locale == i18n_page_locale %}
            {{ notice.translated }}
            {%- if 'en' in page.file.alternates %} <a href="{{ page.file.alternates['en'].url | url }}" lang="en" hreflang="en">{{ notice.english_link }}</a>.{% endif %}
            {%- else %}
            {{ notice.fallback }}
            {%- endif %}
          </div>
          {%- endif %}

          <!-- Page content -->
          <div class="rst-content">
            {% block content %}
            {{ page.content }}
            {% endblock %}
          </div>

          <!-- Navigation footer (prev/next) -->
          {%- include "nav-footer.html.j2" %}
        </article>
      </main>

      <!-- Right sidebar - Table of Contents -->
      {%- if page and page.toc and page.toc.items and not (page.meta and page.meta.widescreen) %}
      <aside class="md-sidebar md-sidebar--secondary" data-md-component="toc" role="complementary" aria-label="Table of contents">
        {%- include "toc.html.j2" %}
      </aside>
      {%- endif %}
    </div>

    <!-- Footer - Full width outside container -->
    <footer class="md-footer" role="contentinfo">
      Built with <a href="https://www.mkdocs.org/">MkDocs</a> using <a href="https://github.com/durera/mkdocs-carbon">Carbon theme</a>
    </footer>
  </body>
</html>